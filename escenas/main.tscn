[sub_resource type="GDScript" id="GDScript_eaw6l"]
resource_name = "platformgenerator"
script/source = "
extends Node2D

const PLATFORM_SCENE = preload(\"res://escenas/platform.tscn\")

# CONFIGURACIÓN
const VERTICAL_GAP = 110.0
const MIN_HORIZONTAL_STEP = 120.0
const MAX_HORIZONTAL_STEP = 190.0
const GENERATE_AHEAD = 900.0

# POSICIONES INTERNAS DE LA PLATAFORMA
const PLATFORM_CENTER_X = 932.125
const PLATFORM_TOP_OFFSET_Y = 481.0
const PLATFORM_HALF_WIDTH = 140.0

# POSICIÓN DEL PISO
const FLOOR_TOP_Y = 582.5
const FIRST_PLATFORM_ABOVE_FLOOR = 110.0

@onready var main: Node2D = get_parent()

var player: CharacterBody2D
var next_platform_y: float
var last_center_x: float


func _ready():

	# BUSCAR AL JUGADOR
	for child in main.get_children():
		if child is CharacterBody2D:
			player = child
			break

	if player == null:
		push_error(\"No se encontró al jugador.\")
		set_process(false)
		return

	# CENTRAR LA PRIMERA PLATAFORMA CON EL JUGADOR
	var screen_width = get_viewport_rect().size.x

	last_center_x = clamp(
		player.global_position.x + 104.6,
		PLATFORM_HALF_WIDTH,
		screen_width - PLATFORM_HALF_WIDTH
	)

	# ALTURA DE LA PRIMERA PLATAFORMA
	next_platform_y = (
		FLOOR_TOP_Y
		- FIRST_PLATFORM_ABOVE_FLOOR
	)

	generate_ahead()


func _process(_delta):

	if player == null:
		return

	generate_ahead()


func generate_ahead():

	while next_platform_y > player.global_position.y - GENERATE_AHEAD:
		create_platform()


func create_platform():

	var screen_width = get_viewport_rect().size.x

	var min_x = PLATFORM_HALF_WIDTH
	var max_x = screen_width - PLATFORM_HALF_WIDTH

	# ELEGIR DIRECCIÓN Y DISTANCIA
	var direction = -1.0 if randf() < 0.5 else 1.0

	var step = randf_range(
		MIN_HORIZONTAL_STEP,
		MAX_HORIZONTAL_STEP
	)

	var new_x = last_center_x + direction * step

	# EVITAR SALIR DE LA PANTALLA
	if new_x < min_x or new_x > max_x:
		new_x = last_center_x - direction * step

	new_x = clamp(new_x, min_x, max_x)

	# CREAR PLATAFORMA
	var new_platform = PLATFORM_SCENE.instantiate()

	new_platform.position = Vector2(
		new_x - PLATFORM_CENTER_X,
		next_platform_y - PLATFORM_TOP_OFFSET_Y
	)

	main.add_child.call_deferred(new_platform)

	# ACTUALIZAR POSICIONES
	last_center_x = new_x
	next_platform_y -= VERTICAL_GAP
"

