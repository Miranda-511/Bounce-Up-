[sub_resource type="GDScript" id="GDScript_esbpa"]
resource_name = "mov"
script/source = "
extends CharacterBody2D

const SPEED = 575.0
const JUMP_VELOCITY = -780.0
const WRAP_MARGIN = 30.0

const CAMERA_SPEED = 1.0
const CAMERA_TRIGGER = 260.0
const FALL_LIMIT = 700.0

@onready var camera: Camera2D = $\"../Camera2D\"
@onready var score_label: Label = $\"../CanvasLayer/ScoreLabel\"
@onready var sprite: Sprite2D = $Sprite2D

var start_y: float
var highest_y: float


func _ready():

	start_y = global_position.y
	highest_y = start_y

	# CONFIGURACIÓN DEL SPRITE SHEET
	sprite.hframes = 4
	sprite.vframes = 4
	sprite.frame = 0


func _physics_process(delta: float) -> void:

	# ==================================
	# GRAVEDAD
	# ==================================

	if not is_on_floor():
		velocity += get_gravity() * delta


	# ==================================
	# MOVIMIENTO HORIZONTAL
	# ==================================

	var direction := Input.get_axis(\"ui_left\", \"ui_right\")

	if direction:
		velocity.x = direction * SPEED
	else:
		velocity.x = move_toward(velocity.x, 0, SPEED)


	# ==================================
	# MOVIMIENTO Y COLISIONES
	# ==================================

	move_and_slide()


	# ==================================
	# REBOTE AUTOMÁTICO
	# ==================================

	if is_on_floor() and velocity.y >= 0:
		velocity.y = JUMP_VELOCITY


	# ==================================
	# ANIMACIÓN
	# ==================================

	update_animation()


	# ==================================
	# SCREEN WRAPPING
	# ==================================

	var screen_width = get_viewport_rect().size.x

	if global_position.x < -WRAP_MARGIN:
		global_position.x = screen_width + WRAP_MARGIN

	elif global_position.x > screen_width + WRAP_MARGIN:
		global_position.x = -WRAP_MARGIN


	# ==================================
	# CÁMARA VERTICAL
	# ==================================

	if global_position.y < camera.global_position.y - CAMERA_TRIGGER:

		var target_y = global_position.y + CAMERA_TRIGGER

		camera.global_position.y = lerp(
			camera.global_position.y,
			target_y,
			min(CAMERA_SPEED * delta, 1.0)
		)


	# ==================================
	# PUNTUACIÓN
	# ==================================

	if global_position.y < highest_y:
		highest_y = global_position.y

	var score = int((start_y - highest_y) / 10.0)

	score_label.text = \"Puntuación: \" + str(max(score, 0))


	# ==================================
	# SI EL JUGADOR CAE, REINICIAR
	# ==================================

	if global_position.y > camera.global_position.y + FALL_LIMIT:
		get_tree().reload_current_scene()


# ==================================
# ANIMACIÓN DEL JUGADOR
# ==================================

func update_animation():

	# TOCANDO EL SUELO
	if is_on_floor():
		sprite.frame = 0

	# SUBIENDO
	elif velocity.y < -100.0:
		sprite.frame = 4

	# PUNTO MÁS ALTO
	elif velocity.y <= 150.0:
		sprite.frame = 8

	# CAYENDO
	else:
		sprite.frame = 12
"

