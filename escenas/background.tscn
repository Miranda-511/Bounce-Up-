resource_name = "bg"
script/source = "
extends Node2D

# ==================================
# CONFIGURACIÓN GENERAL
# ==================================

const CLOUD_TEXTURE = preload(\"res://assets/cloud.webp\")

const CLOUDS_START_HEIGHT = 1200.0
const CLOUD_AHEAD = 1400.0
const CLOUD_SPACING_MIN = 450.0
const CLOUD_SPACING_MAX = 700.0
const CLOUD_FADE_START = 8500.0
const CLOUD_FADE_END = 13000.0

const STAR_START_HEIGHT = 20000.0
const STAR_AHEAD = 1500.0

const PLANET_START_HEIGHT = 30000.0
const PLANET_AHEAD = 2500.0
const PLANET_SPACING_MIN = 2800.0
const PLANET_SPACING_MAX = 4500.0

const SPACE_OBJECT_START = 28000.0
const SPACE_OBJECT_AHEAD = 1800.0
const SPACE_OBJECT_SPACING_MIN = 450.0
const SPACE_OBJECT_SPACING_MAX = 800.0

const FOREST_BOTTOM = 1150.0

var main
var player: CharacterBody2D
var camera: Camera2D
var start_y: float

var sky: ColorRect

var forest_layer: Node2D
var cloud_layer: Node2D
var star_layer: Node2D
var planet_layer: Node2D
var space_layer: Node2D

var next_cloud_y: float
var next_star_y: float
var next_planet_y: float
var next_space_y: float


func _ready():

	z_index = -20

	randomize()

	main = get_parent()

	await get_tree().process_frame

	player = main.get_node_or_null(\"player\") as CharacterBody2D
	camera = main.get_node_or_null(\"Camera2D\") as Camera2D

	if player == null:
		push_error(\"No se encontró el nodo player.\")
		set_process(false)
		return

	start_y = player.global_position.y

	create_sky()
	create_world_layers()
	create_forest()

	next_cloud_y = start_y - CLOUDS_START_HEIGHT
	next_star_y = start_y - STAR_START_HEIGHT
	next_planet_y = start_y - PLANET_START_HEIGHT
	next_space_y = start_y - SPACE_OBJECT_START

	generate_clouds_ahead()
	generate_stars_ahead()
	generate_planets_ahead()
	generate_space_objects_ahead()


func _process(_delta):

	if player == null:
		return

	var height = maxf(
		0.0,
		start_y - player.global_position.y
	)

	sky.color = get_sky_color(height)

	generate_clouds_ahead()
	generate_stars_ahead()
	generate_planets_ahead()
	generate_space_objects_ahead()

	cleanup_old_decorations()


# ==================================
# ANCHO VISIBLE DE LA CÁMARA
# ==================================

func get_world_bounds() -> Vector2:

	var viewport_width = get_viewport_rect().size.x
	var zoom_value = 1.0

	if camera != null:
		zoom_value = camera.zoom.x

	var visible_width = viewport_width / zoom_value
	var center_x = 576.0

	if camera != null:
		center_x = camera.get_screen_center_position().x

	return Vector2(
		center_x - visible_width * 0.5 - 250.0,
		center_x + visible_width * 0.5 + 250.0
	)


# ==================================
# CIELO
# ==================================

func create_sky():

	var sky_canvas = CanvasLayer.new()
	sky_canvas.name = \"SkyLayer\"
	sky_canvas.layer = -1

	add_child(sky_canvas)

	sky = ColorRect.new()
	sky.name = \"Sky\"
	sky.color = Color(\"#8BD7F6\")

	sky.set_anchors_and_offsets_preset(
		Control.PRESET_FULL_RECT
	)

	sky.mouse_filter = Control.MOUSE_FILTER_IGNORE

	sky_canvas.add_child(sky)


func get_sky_color(height: float) -> Color:

	var sky_1 = Color(\"#8BD7F6\")
	var sky_2 = Color(\"#4C9BD1\")
	var sky_3 = Color(\"#344A81\")
	var sky_4 = Color(\"#252047\")
	var sky_5 = Color(\"#090F25\")

	if height < 9000.0:
		return sky_1.lerp(sky_2, height / 9000.0)

	elif height < 15000.0:
		return sky_2.lerp(
			sky_3,
			(height - 9000.0) / 6000.0
		)

	elif height < 22000.0:
		return sky_3.lerp(
			sky_4,
			(height - 15000.0) / 7000.0
		)

	elif height < 30000.0:
		return sky_4.lerp(
			sky_5,
			(height - 22000.0) / 8000.0
		)

	return sky_5


# ==================================
# CAPAS
# ==================================

func create_world_layers():

	forest_layer = Node2D.new()
	forest_layer.name = \"Forest\"
	forest_layer.z_index = -2
	add_child(forest_layer)

	cloud_layer = Node2D.new()
	cloud_layer.name = \"Clouds\"
	add_child(cloud_layer)

	star_layer = Node2D.new()
	star_layer.name = \"Stars\"
	star_layer.z_index = 1
	add_child(star_layer)

	planet_layer = Node2D.new()
	planet_layer.name = \"Planets\"
	planet_layer.z_index = 2
	add_child(planet_layer)

	space_layer = Node2D.new()
	space_layer.name = \"SpaceObjects\"
	space_layer.z_index = 3
	add_child(space_layer)


# ==================================
# BOSQUE
# ==================================

func create_forest():

	var bounds = get_world_bounds()
	var left = bounds.x
	var right = bounds.y
	var width = right - left

	# CIELO DECORATIVO DEL HORIZONTE
	var distant_hill = create_hill(
		\"FarForest\",
		left,
		right,
		690.0,
		65.0,
		Color(\"#91B99B\"),
		-5
	)

	forest_layer.add_child(distant_hill)

	# ÁRBOLES LEJANOS
	var far_tree_colors = [
		Color(\"#547F69\"),
		Color(\"#638D70\"),
		Color(\"#729B7A\"),
		Color(\"#47745F\")
	]

	for i in range(30):

		var x = left + width * float(i) / 29.0
		x += randf_range(-35.0, 35.0)

		var y = randf_range(625.0, 710.0)

		create_tree(
			x,
			y,
			randf_range(0.65, 0.95),
			far_tree_colors,
			-4
		)

	# COLINAS INTERMEDIAS
	var middle_hill = create_hill(
		\"MiddleForest\",
		left,
		right,
		790.0,
		75.0,
		Color(\"#4E9169\"),
		-3
	)

	forest_layer.add_child(middle_hill)

	# ÁRBOLES MEDIANOS
	var middle_tree_colors = [
		Color(\"#347B50\"),
		Color(\"#438B59\"),
		Color(\"#579C65\"),
		Color(\"#286A48\")
	]

	for i in range(23):

		var x = randf_range(left, right)
		var y = randf_range(700.0, 810.0)

		create_tree(
			x,
			y,
			randf_range(0.85, 1.2),
			middle_tree_colors,
			-2
		)

	# COLINA DELANTERA
	var front_hill = create_hill(
		\"FrontForest\",
		left,
		right,
		900.0,
		65.0,
		Color(\"#367C4B\"),
		-1
	)

	forest_layer.add_child(front_hill)

	# ÁRBOLES DELANTEROS
	var front_tree_colors = [
		Color(\"#23633E\"),
		Color(\"#2E7547\"),
		Color(\"#39834F\"),
		Color(\"#1C5938\")
	]

	for i in range(17):

		var x = randf_range(left, right)
		var y = randf_range(830.0, 940.0)

		create_tree(
			x,
			y,
			randf_range(1.1, 1.55),
			front_tree_colors,
			0
		)

	# ARBUSTOS Y VEGETACIÓN
	for i in range(45):

		var x = randf_range(left, right)
		var y = randf_range(720.0, 1010.0)

		create_bush(
			x,
			y,
			randf_range(0.55, 1.15)
		)

	# FLORES DECORATIVAS
	for i in range(45):

		var x = randf_range(left, right)
		var y = randf_range(850.0, 1080.0)

		create_flower(x, y)


func create_hill(
	hill_name: String,
	left: float,
	right: float,
	base_y: float,
	amplitude: float,
	color: Color,
	layer_z: int
) -> Node2D:

	var layer = Node2D.new()
	layer.name = hill_name
	layer.z_index = layer_z

	var points = PackedVector2Array()

	var segments = 40

	for i in range(segments + 1):

		var t = float(i) / float(segments)
		var x = lerpf(left, right, t)

		var wave = (
			sin(t * TAU * 2.0) * 0.45 +
			sin(t * TAU * 4.0 + 1.5) * 0.25 +
			sin(t * TAU * 7.0) * 0.15
		)

		var y = base_y + wave * amplitude

		points.append(Vector2(x, y))

	points.append(Vector2(right, FOREST_BOTTOM))
	points.append(Vector2(left, FOREST_BOTTOM))

	var hill = Polygon2D.new()
	hill.name = \"Hill\"
	hill.polygon = points
	hill.color = color

	layer.add_child(hill)

	# BRILLO SUAVE EN EL BORDE
	var highlight = Line2D.new()
	highlight.name = \"HillHighlight\"
	highlight.width = 4.0
	highlight.default_color = color.lightened(0.15)

	var line_points = PackedVector2Array()

	for i in range(segments + 1):
		line_points.append(points[i])

	highlight.points = line_points
	layer.add_child(highlight)

	return layer


# ==================================
# ÁRBOLES
# ==================================

func create_tree(
	x: float,
	y: float,
	tree_scale: float,
	colors: Array,
	layer_z: int
):

	var tree = Node2D.new()
	tree.position = Vector2(x, y)
	tree.scale = Vector2.ONE * tree_scale
	tree.z_index = layer_z

	# TRONCO
	var trunk = Polygon2D.new()

	trunk.polygon = PackedVector2Array([
		Vector2(-13, -5),
		Vector2(13, -5),
		Vector2(10, 75),
		Vector2(-10, 75)
	])

	trunk.color = Color(\"#80563D\")

	tree.add_child(trunk)

	# SOMBRA DEL TRONCO
	var trunk_shadow = Polygon2D.new()

	trunk_shadow.polygon = PackedVector2Array([
		Vector2(3, 0),
		Vector2(13, -5),
		Vector2(10, 75),
		Vector2(2, 75)
	])

	trunk_shadow.color = Color(\"#64432F\")

	tree.add_child(trunk_shadow)

	# COPA REDONDEADA
	var crown_positions = [
		Vector2(0, -65),
		Vector2(-34, -43),
		Vector2(34, -42),
		Vector2(-22, -83),
		Vector2(23, -87),
		Vector2(0, -105)
	]

	for i in range(crown_positions.size()):

		var crown = Polygon2D.new()
		crown.polygon = make_circle(
			randf_range(30.0, 42.0),
			32
		)

		crown.position = crown_positions[i]

		var color_index = randi_range(
			0,
			colors.size() - 1
		)

		crown.color = colors[color_index]

		tree.add_child(crown)

	# DETALLES DE LUZ
	for i in range(3):

		var light = Polygon2D.new()

		light.polygon = make_circle(
			randf_range(7.0, 12.0),
			24
		)

		light.position = Vector2(
			randf_range(-28.0, 28.0),
			randf_range(-95.0, -45.0)
		)

		light.color = colors[0].lightened(0.22)
		light.color.a = 0.65

		tree.add_child(light)

	forest_layer.add_child(tree)


# ==================================
# ARBUSTOS
# ==================================

func create_bush(x: float, y: float, bush_scale: float):

	var bush = Node2D.new()
	bush.position = Vector2(x, y)
	bush.scale = Vector2.ONE * bush_scale

	var colors = [
		Color(\"#34794B\"),
		Color(\"#438B53\"),
		Color(\"#579D60\")
	]

	for i in range(4):

		var leaf = Polygon2D.new()

		leaf.polygon = make_circle(
			randf_range(17.0, 25.0),
			24
		)

		leaf.position = Vector2(
			(i - 1.5) * 17.0,
			randf_range(-8.0, 8.0)
		)

		leaf.color = colors[
			randi_range(0, colors.size() - 1)
		]

		bush.add_child(leaf)

	forest_layer.add_child(bush)


# ==================================
# FLORES
# ==================================

func create_flower(x: float, y: float):

	var flower = Node2D.new()
	flower.position = Vector2(x, y)

	var stem = Line2D.new()
	stem.points = PackedVector2Array([
		Vector2.ZERO,
		Vector2(0, -12)
	])

	stem.width = 2.0
	stem.default_color = Color(\"#376D3E\")

	flower.add_child(stem)

	var flower_colors = [
		Color(\"#F7D77A\"),
		Color(\"#F4A6A6\"),
		Color(\"#E9D8F7\"),
		Color(\"#FFFFFF\")
	]

	var petal_color = flower_colors[
		randi_range(0, flower_colors.size() - 1)
	]

	for i in range(5):

		var angle = TAU * float(i) / 5.0

		var petal = Polygon2D.new()
		petal.polygon = make_circle(3.5, 16)

		petal.position = Vector2(
			cos(angle) * 5.0,
			-12.0 + sin(angle) * 5.0
		)

		petal.color = petal_color

		flower.add_child(petal)

	var center = Polygon2D.new()
	center.polygon = make_circle(2.5, 16)
	center.position = Vector2(0, -12)
	center.color = Color(\"#E8B84B\")

	flower.add_child(center)

	forest_layer.add_child(flower)


# ==================================
# NUBES
# ==================================

func create_cloud(cloud_y: float):

	var altitude = start_y - cloud_y

	var fade = clampf(
		(altitude - CLOUD_FADE_START) /
		(CLOUD_FADE_END - CLOUD_FADE_START),
		0.0,
		1.0
	)

	var alpha = 0.82 * (1.0 - fade)

	if alpha <= 0.02:
		return

	var bounds = get_world_bounds()

	var cloud = Sprite2D.new()
	cloud.texture = CLOUD_TEXTURE

	cloud.position = Vector2(
		randf_range(bounds.x, bounds.y),
		cloud_y
	)

	var cloud_size = randf_range(0.75, 1.25)

	cloud.scale = Vector2.ONE * cloud_size
	cloud.flip_h = randf() < 0.5
	cloud.modulate = Color(1, 1, 1, alpha)

	cloud_layer.add_child(cloud)


func generate_clouds_ahead():

	while next_cloud_y > player.global_position.y - CLOUD_AHEAD:

		create_cloud(next_cloud_y)

		if randf() < 0.30:

			create_cloud(
				next_cloud_y + randf_range(100.0, 220.0)
			)

		next_cloud_y -= randf_range(
			CLOUD_SPACING_MIN,
			CLOUD_SPACING_MAX
		)


# ==================================
# FORMAS
# ==================================

func make_circle(
	radius: float,
	segments: int = 32
) -> PackedVector2Array:

	var points = PackedVector2Array()

	for i in range(segments):

		var angle = TAU * float(i) / float(segments)

		points.append(
			Vector2(cos(angle), sin(angle)) * radius
		)

	return points


func make_star(radius: float) -> PackedVector2Array:

	var points = PackedVector2Array()

	for i in range(8):

		var angle = -PI / 2.0 + TAU * i / 8.0
		var r = radius

		if i % 2 != 0:
			r *= 0.3

		points.append(
			Vector2(cos(angle), sin(angle)) * r
		)

	return points


# ==================================
# ESTRELLAS
# ==================================

func create_star(star_y: float):

	var bounds = get_world_bounds()

	var star = Polygon2D.new()
	var radius = randf_range(2.0, 4.0)

	star.polygon = make_star(radius)

	star.color = Color(
		1.0,
		1.0,
		1.0,
		randf_range(0.45, 1.0)
	)

	star.position = Vector2(
		randf_range(bounds.x, bounds.y),
		star_y
	)

	star_layer.add_child(star)


func generate_stars_ahead():

	while next_star_y > player.global_position.y - STAR_AHEAD:

		for i in range(randi_range(3, 6)):

			create_star(
				next_star_y + randf_range(-100.0, 100.0)
			)

		next_star_y -= randf_range(100.0, 180.0)


# ==================================
# PLANETAS
# ==================================

func create_planet(planet_y: float):

	var bounds = get_world_bounds()

	var planet = Node2D.new()
	planet.name = \"Planet\"

	planet.position = Vector2(
		randf_range(bounds.x + 150.0, bounds.y - 150.0),
		planet_y
	)

	var radius = randf_range(45.0, 85.0)

	var planet_colors = [
		Color(\"#D58B76\"),
		Color(\"#B49ADB\"),
		Color(\"#78A9B8\"),
		Color(\"#D6B66D\"),
		Color(\"#A6A6B8\"),
		Color(\"#C77F9C\")
	]

	var planet_color: Color = planet_colors[
		randi_range(0, planet_colors.size() - 1)
	]

	if randf() < 0.55:

		var ring = Line2D.new()
		ring.width = randf_range(3.0, 6.0)
		ring.default_color = planet_color.lightened(0.35)

		var ring_points = PackedVector2Array()

		for i in range(49):

			var angle = TAU * float(i) / 48.0

			ring_points.append(
				Vector2(
					cos(angle) * radius * 1.65,
					sin(angle) * radius * 0.48
				)
			)

		ring.points = ring_points
		planet.add_child(ring)

	var halo = Polygon2D.new()
	halo.polygon = make_circle(radius * 1.12)
	halo.color = planet_color.lightened(0.35)
	halo.color.a = 0.16

	planet.add_child(halo)

	var body = Polygon2D.new()
	body.polygon = make_circle(radius, 48)
	body.color = planet_color

	planet.add_child(body)

	for i in range(randi_range(2, 4)):

		var crater = Polygon2D.new()
		var crater_radius = radius * randf_range(0.07, 0.15)

		crater.polygon = make_circle(crater_radius, 16)

		crater.position = Vector2(
			randf_range(-radius * 0.55, radius * 0.55),
			randf_range(-radius * 0.45, radius * 0.45)
		)

		crater.color = planet_color.darkened(0.22)

		planet.add_child(crater)

	planet_layer.add_child(planet)


func generate_planets_ahead():

	while next_planet_y > player.global_position.y - PLANET_AHEAD:

		create_planet(next_planet_y)

		if randf() < 0.25:

			create_planet(
				next_planet_y + randf_range(250.0, 500.0)
			)

		next_planet_y -= randf_range(
			PLANET_SPACING_MIN,
			PLANET_SPACING_MAX
		)


# ==================================
# ASTEROIDES
# ==================================

func create_asteroid(asteroid_y: float):

	var bounds = get_world_bounds()

	var asteroid = Node2D.new()

	asteroid.position = Vector2(
		randf_range(bounds.x, bounds.y),
		asteroid_y
	)

	var radius = randf_range(12.0, 27.0)
	var points = PackedVector2Array()

	var segments = randi_range(7, 10)

	for i in range(segments):

		var angle = TAU * float(i) / float(segments)
		var variation = randf_range(0.75, 1.2)

		points.append(
			Vector2(cos(angle), sin(angle)) * radius * variation
		)

	var body = Polygon2D.new()
	body.polygon = points
	body.color = Color(\"#85818B\")

	asteroid.add_child(body)

	var crater = Polygon2D.new()
	crater.polygon = make_circle(radius * 0.18, 12)
	crater.position = Vector2(radius * 0.3, -radius * 0.2)
	crater.color = Color(\"#55515E\")

	asteroid.add_child(crater)

	space_layer.add_child(asteroid)


# ==================================
# SATÉLITES
# ==================================

func add_rectangle(
	parent: Node2D,
	center: Vector2,
	size: Vector2,
	color: Color
):

	var rect = Polygon2D.new()
	var half = size / 2.0

	rect.polygon = PackedVector2Array([
		Vector2(-half.x, -half.y),
		Vector2(half.x, -half.y),
		Vector2(half.x, half.y),
		Vector2(-half.x, half.y)
	])

	rect.position = center
	rect.color = color

	parent.add_child(rect)


func create_satellite(satellite_y: float):

	var bounds = get_world_bounds()

	var satellite = Node2D.new()

	satellite.position = Vector2(
		randf_range(bounds.x + 150.0, bounds.y - 150.0),
		satellite_y
	)

	satellite.rotation = randf_range(-0.35, 0.35)

	var color = Color(\"#B8C4D8\")

	add_rectangle(
		satellite,
		Vector2(-35, 0),
		Vector2(28, 15),
		Color(\"#567AA5\")
	)

	add_rectangle(
		satellite,
		Vector2(35, 0),
		Vector2(28, 15),
		Color(\"#567AA5\")
	)

	add_rectangle(
		satellite,
		Vector2.ZERO,
		Vector2(22, 22),
		color
	)

	var antenna = Line2D.new()

	antenna.points = PackedVector2Array([
		Vector2(0, -11),
		Vector2(0, -24),
		Vector2(10, -30)
	])

	antenna.width = 2.0
	antenna.default_color = color

	satellite.add_child(antenna)

	space_layer.add_child(satellite)


# ==================================
# COMETAS
# ==================================

func create_comet(comet_y: float):

	var bounds = get_world_bounds()

	var comet = Node2D.new()

	comet.position = Vector2(
		randf_range(bounds.x + 100.0, bounds.y - 100.0),
		comet_y
	)

	var tail = Line2D.new()

	tail.points = PackedVector2Array([
		Vector2(-85, 65),
		Vector2(-35, 25),
		Vector2.ZERO
	])

	tail.width = 3.0
	tail.default_color = Color(\"#B8DFFF\")

	comet.add_child(tail)

	var head = Polygon2D.new()
	head.polygon = make_star(5.0)
	head.color = Color.WHITE

	comet.add_child(head)

	space_layer.add_child(comet)


# ==================================
# GENERACIÓN ESPACIAL
# ==================================

func generate_space_objects_ahead():

	while next_space_y > player.global_position.y - SPACE_OBJECT_AHEAD:

		var type = randf()

		if type < 0.50:
			create_asteroid(next_space_y)

		elif type < 0.78:
			create_satellite(next_space_y)

		else:
			create_comet(next_space_y)

		next_space_y -= randf_range(
			SPACE_OBJECT_SPACING_MIN,
			SPACE_OBJECT_SPACING_MAX
		)


# ==================================
# LIMPIEZA
# ==================================

func cleanup_old_decorations():

	for cloud in cloud_layer.get_children():

		if cloud.global_position.y > player.global_position.y + 1300.0:
			cloud.queue_free()

	for star in star_layer.get_children():

		if star.global_position.y > player.global_position.y + 1500.0:
			star.queue_free()

	for planet in planet_layer.get_children():

		if planet.global_position.y > player.global_position.y + 8000.0:
			planet.queue_free()

	for object in space_layer.get_children():

		if object.global_position.y > player.global_position.y + 2500.0:
			object.queue_free()
